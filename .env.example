# =============================================================================
# ⚙️ CẤU HÌNH LLM — COPY FILE NÀY THÀNH `.env` RỒI ĐIỀN KEY CỦA RIÊNG BẠN
#
#   Windows : copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# ⚠️ File `.env` đã nằm trong .gitignore — TUYỆT ĐỐI KHÔNG commit key lên GitHub.
# =============================================================================


# =============================================================================
# 🔧 CÁCH DÙNG CHUNG CHO CẢ NHÓM (KHUYẾN NGHỊ)
# -----------------------------------------------------------------------------
# Hầu hết nhà cung cấp LLM đều có endpoint TƯƠNG THÍCH CHUẨN OpenAI. Vì vậy chỉ
# cần 4 biến dưới đây là chạy được với BẤT KỲ nhà cung cấp nào — mỗi thành viên
# dùng key/endpoint riêng mà KHÔNG phải sửa một dòng code nào.
# =============================================================================

LLM_PROVIDER=custom
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=meta/llama-3.3-70b-instruct


# -----------------------------------------------------------------------------
# 📋 BẢNG THAM CHIẾU ENDPOINT (chỉ cần đổi LLM_BASE_URL + LLM_MODEL)
# -----------------------------------------------------------------------------
#  Nhà cung cấp | LLM_BASE_URL                          | LLM_MODEL ví dụ
#  -------------|---------------------------------------|-----------------------------
#  NVIDIA NIM   | https://integrate.api.nvidia.com/v1   | meta/llama-3.3-70b-instruct
#  Groq         | https://api.groq.com/openai/v1        | llama-3.3-70b-versatile
#  Together AI  | https://api.together.xyz/v1           | meta-llama/Llama-3.3-70B-Instruct-Turbo
#  DeepSeek     | https://api.deepseek.com/v1           | deepseek-chat
#  OpenAI       | https://api.openai.com/v1             | gpt-4o-mini
#  Ollama (máy) | http://localhost:11434/v1             | llama3.3          (key điền bừa)
#  LM Studio    | http://localhost:1234/v1              | (tên model đang load)
# -----------------------------------------------------------------------------


# =============================================================================
# 🧪 CHẠY OFFLINE KHÔNG CẦN API KEY
# -----------------------------------------------------------------------------
# Đặt LLM_PROVIDER=mock để chạy thử toàn bộ vòng lặp ReAct mà không tốn quota.
# Mock KHÔNG phải bản in cứng kết quả: nó đọc transcript thật và sinh bước
# Thought/Action tiếp theo, nên parser, executor và guardrail đều được chạy đủ.
# Rất hợp để debug hoặc khi hết quota giữa buổi lab.
# =============================================================================


# =============================================================================
# 🔌 (TÙY CHỌN) CÁC PROVIDER CÓ SDK RIÊNG
# -----------------------------------------------------------------------------
# Nếu muốn dùng SDK gốc thay vì endpoint tương thích OpenAI, đặt LLM_PROVIDER
# thành một trong: gemini | openai | anthropic | openrouter
# rồi điền key tương ứng bên dưới.
# =============================================================================

GEMINI_API_KEY=
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model mặc định nếu để trống LLM_MODEL:
#   gemini     ➔ gemini-2.5-flash
#   openai     ➔ gpt-4o-mini
#   anthropic  ➔ claude-3-haiku-20240307
#   openrouter ➔ google/gemini-2.5-flash
