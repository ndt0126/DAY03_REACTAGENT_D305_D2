flowchart TD
    Start(["Khách hàng gửi yêu cầu (User Query)"]) --> CheckQuery{"Phân loại yêu cầu?"}
    
    %% Branch 1: Baseline Path
    CheckQuery -- "Hỏi kinh nghiệm / lý thuyết chung" --> ChatbotPath["Chatbot Baseline (1 Call LLM)"]
    ChatbotPath --> DirectResp["Trả lời dựa trên tri thức sẵn có"]
    DirectResp --> End1(["Hoàn thành"])
    
    %% Branch 2: ReAct Agent Path
    CheckQuery -- "Cần tra cứu phòng / Đặt lịch xem nhà" --> AgentPath["ReAct Agent Engine (src/app.py)"]
    AgentPath --> Thought1["Thought: Phân tích nhu cầu & chọn Tool"]
    Thought1 --> Action1["Action: Gọi Tool Spec (src/tools.py)"]
    
    Action1 --> ExecTool{"Thực thi Tool API"}
    ExecTool -- "Thành công" --> ObsPass["Observation: Trả về kết quả thực tế"]
    ExecTool -- "Lỗi / Không tìm thấy" --> ObsErr["Observation: Thông báo lỗi an toàn"]
    
    ObsPass --> StepCheck{"Đã đủ dữ liệu chưa?"}
    ObsErr --> StepCheck
    
    StepCheck -- "Chưa đủ (Cần thêm bước)" --> IterGuard{"Chạm MAX_ITERATIONS?"}
    IterGuard -- "Chưa (step < 4)" --> Thought1
    IterGuard -- "Đã chạm limit" --> GuardAlert["🛡️ Guardrail Ngắt An Toàn"]
    GuardAlert --> End2(["Thông báo ngắt lặp"])
    
    StepCheck -- "Đã đủ thông tin" --> FinalAnswer["Final Answer: Tổng hợp kết quả & Xác nhận"]
    FinalAnswer --> End3(["Hoàn thành & Gửi khách hàng"])
